# ==============================================================================
# NutriSnap AI - Environment Variables (Global & US Launch)
# ==============================================================================

# 1. Supabase (Free Tier Auth & PostgreSQL Database)
# https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2. Google Gemini API (Multimodal Meal Analysis)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6...
GEMINI_MODEL=gemini-3.8-flash

# 3. Polar.sh (Global Payments & Subscriptions)
# https://polar.sh or https://sandbox.polar.sh
# Settings -> Developers -> Access Tokens:
POLAR_ACCESS_TOKEN=polar_at_...

# Settings -> Developers -> Webhooks -> Add Endpoint (e.g. https://yourdomain.com/api/webhook/polar):
POLAR_WEBHOOK_SECRET=polar_whs_...

# Products -> NutriSnap Pro ($9.99/mo) -> Copy Product ID:
POLAR_PRODUCT_ID=prod_...

# Environment: "sandbox" for testing, "production" for live
POLAR_ENVIRONMENT=sandbox

# 4. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
